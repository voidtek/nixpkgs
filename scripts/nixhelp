echo "  web       - Web & static sites (hugo, nodejs, go, libwebp, imagemagick)"
echo "  devops    - Infrastructure (opentofu, kubectl, talosctl, k9s, helm, aws-cli)"
echo "  ai        - AI/ML development (python3, jupyter, numpy, pandas, scikit-learn, openai)"
echo "  kotlin    - Kotlin development (kotlin, gradle, openjdk21, android-studio)"
echo "  security  - Security auditing (osv-scanner, pip-audit)"
echo ""
echo "Usage:"
echo "  nix develop github:voidtek/nixpkgs#<environment>"
echo ""
echo "Example:"
echo "  nix develop github:voidtek/nixpkgs#devops"
